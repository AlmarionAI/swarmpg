+--
+-- SwarmPG: per-statement agent budgets (agent_max_rows, agent_max_cost) and
+-- their tighten-only GUC_RATCHET rule
+--
+CREATE TABLE agent_budget_t (id int);
+INSERT INTO agent_budget_t SELECT g FROM generate_series(1, 20) g;
+CREATE ROLE regress_agent_budget;
+GRANT ALL ON agent_budget_t TO regress_agent_budget;
+SELECT 'RATCHET' = ANY(pg_settings_get_flags('agent_max_rows')) AS rows_ratchet,
+       'RATCHET' = ANY(pg_settings_get_flags('agent_max_cost')) AS cost_ratchet;
+
+-- row budget: a SELECT returns at most agent_max_rows rows to the client
+SET agent_max_rows = 5;
+SELECT id FROM agent_budget_t ORDER BY id;               -- 5 rows, then a notice
+SELECT id FROM agent_budget_t WHERE id <= 5 ORDER BY id; -- exactly 5: no notice
+SELECT count(*) FROM agent_budget_t;                     -- an aggregate sees every row
+-- a query inside a function still sees every row
+CREATE FUNCTION agent_budget_count() RETURNS bigint LANGUAGE plpgsql AS $$
+DECLARE n bigint := 0; r record;
+BEGIN
+  FOR r IN SELECT id FROM agent_budget_t LOOP n := n + 1; END LOOP;
+  RETURN n;
+END $$;
+SELECT agent_budget_count();
+-- a statement that would modify more rows fails as a whole
+UPDATE agent_budget_t SET id = id WHERE id <= 5;         -- 5 rows: allowed
+UPDATE agent_budget_t SET id = id + 100;                 -- fails
+WITH d AS (DELETE FROM agent_budget_t RETURNING id)
+  SELECT count(*) FROM d;                                -- fails: CTE writes count
+INSERT INTO agent_budget_t SELECT g FROM generate_series(1, 6) g;  -- fails
+SELECT count(*), max(id) FROM agent_budget_t;            -- unchanged: 20 rows, max 20
+RESET agent_max_rows;
+
+-- cost budget: an over-budget plan is refused before it runs
+SET agent_max_cost = 1000;
+SELECT count(*) FROM agent_budget_t;                     -- cheap: allowed
+\set VERBOSITY terse
+SELECT count(*) FROM generate_series(1, 100000) a, generate_series(1, 100000) b;  -- fails
+EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
+  SELECT count(*) FROM generate_series(1, 100000) a, generate_series(1, 100000) b;  -- fails: ANALYZE runs it
+SELECT query_to_xml('SELECT count(*) FROM generate_series(1, 100000) a, generate_series(1, 100000) b',
+                    false, false, '');                   -- fails: gated at every level
+\set VERBOSITY default
+DO $$
+BEGIN
+  EXECUTE 'EXPLAIN SELECT count(*) FROM generate_series(1, 100000) a, generate_series(1, 100000) b';
+  RAISE NOTICE 'EXPLAIN without ANALYZE is allowed';
+END $$;
+RESET agent_max_cost;
+
+-- without permission to set them, a session may only lower its budgets
+SET agent_max_rows = 100;
+SET ROLE regress_agent_budget;
+SET agent_max_rows = 50;                 -- lower: allowed
+SET agent_max_rows = 50;                 -- equal: allowed
+SET agent_max_rows = 80;                 -- fails: higher
+SET agent_max_rows = 0;                  -- fails: 0 means no limit
+RESET agent_max_rows;                    -- fails: the reset value is higher
+SELECT set_config('agent_max_rows', '200', false);   -- fails
+BEGIN;
+SET LOCAL agent_max_rows = 10;
+SET LOCAL agent_max_rows = 20;           -- fails: higher than the local limit
+ROLLBACK;
+SHOW agent_max_rows;                     -- 50: the local scope ended
+RESET ALL;                               -- skips the budgets (GUC_NO_RESET_ALL)
+SHOW agent_max_rows;
+SET agent_max_cost = 10;                 -- lower than no limit: allowed
+SET agent_max_cost = 0;                  -- fails
+ALTER ROLE regress_agent_budget SET agent_max_rows = 0;   -- fails
+RESET ROLE;
+RESET agent_max_rows;                    -- a superuser may raise it again
+RESET agent_max_cost;
+SHOW agent_max_rows;
+
+DROP FUNCTION agent_budget_count();
+DROP TABLE agent_budget_t;
+DROP ROLE regress_agent_budget;
