diff --git a/src/backend/executor/execMain.c b/src/backend/executor/execMain.c
index be23640..ef161a8 100644
--- a/src/backend/executor/execMain.c
+++ b/src/backend/executor/execMain.c
@@ -169,6 +169,25 @@ standard_ExecutorStart(QueryDesc *queryDesc, int eflags)
 				 errmsg("no agent principal established"),
 				 errdetail("agent_require_principal is on and agent_principal is not set for this session or transaction.")));
 
+	/*
+	 * SwarmPG: pre-execution cost gate.  Refuse a plan whose estimated total
+	 * cost exceeds agent_max_cost before it does any work, the cheapest
+	 * defense against a runaway agent query.  It applies at every nesting
+	 * level, so SQL run through functions such as query_to_xml() is gated
+	 * too.  EXPLAIN without ANALYZE never runs the plan and is allowed, so an
+	 * agent can see the estimate it was refused for.
+	 */
+	if (agent_max_cost > 0 && !(eflags & EXEC_FLAG_EXPLAIN_ONLY) &&
+		queryDesc->plannedstmt->planTree != NULL &&
+		queryDesc->plannedstmt->planTree->total_cost > agent_max_cost)
+		ereport(ERROR,
+				(errcode(ERRCODE_CONFIGURATION_LIMIT_EXCEEDED),
+				 errmsg("query exceeds the agent cost budget"),
+				 errdetail("Estimated cost is %.0f; agent_max_cost is %.0f.",
+						   queryDesc->plannedstmt->planTree->total_cost,
+						   agent_max_cost),
+				 errhint("Add a selective WHERE clause or a LIMIT. EXPLAIN shows the estimate without running the query.")));
+
 	/*
 	 * If the transaction is read-only, we need to check if any writes are
 	 * planned to non-temporary tables.  EXPLAIN is considered read-only.
@@ -1713,12 +1732,25 @@ ExecutePlan(QueryDesc *queryDesc,
 	bool		use_parallel_mode;
 	TupleTableSlot *slot;
 	uint64		current_tuple_count;
+	bool		cap_rows;
 
 	/*
 	 * initialize local variables
 	 */
 	current_tuple_count = 0;
 
+	/*
+	 * SwarmPG: agent_max_rows caps the rows a SELECT returns to the client,
+	 * counted across every fetch from the same portal.  Only results bound
+	 * for the client (or COPY TO) are capped: the same query run inside a
+	 * function must still see all of its rows.
+	 */
+	cap_rows = agent_max_rows > 0 && operation == CMD_SELECT &&
+		(dest->mydest == DestRemote ||
+		 dest->mydest == DestRemoteExecute ||
+		 dest->mydest == DestRemoteSimple ||
+		 dest->mydest == DestCopyOut);
+
 	/*
 	 * Set the direction.
 	 */
@@ -1761,6 +1793,17 @@ ExecutePlan(QueryDesc *queryDesc,
 		if (TupIsNull(slot))
 			break;
 
+		/* SwarmPG: stop at the row budget, saying so only if more rows exist */
+		if (cap_rows &&
+			estate->es_total_processed + estate->es_processed >=
+			(uint64) agent_max_rows)
+		{
+			ereport(NOTICE,
+					(errmsg("result truncated at the agent row budget of %d rows",
+							agent_max_rows)));
+			break;
+		}
+
 		/*
 		 * If we have a junk filter, then project a new tuple with the junk
 		 * removed.
