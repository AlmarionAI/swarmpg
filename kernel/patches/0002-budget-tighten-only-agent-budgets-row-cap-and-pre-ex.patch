  * set_config_with_handle: sets option `name' to given value.
  *
@@ -3318,6 +3338,7 @@ set_config_with_handle(const char *name, config_handle *handle,
 	union config_var_val newval_union;
 	void	   *newextra = NULL;
 	bool		prohibitValueChange = false;
+	bool		ratchet = false;
 	bool		makeDefault;
 
 	if (elevel == 0)
@@ -3506,6 +3527,16 @@ set_config_with_handle(const char *name, config_handle *handle,
 				aclresult = pg_parameter_aclcheck(record->name, srole, ACL_SET);
 				if (aclresult != ACLCHECK_OK)
 				{
+					/*
+					 * SwarmPG: a GUC_RATCHET budget may still be tightened
+					 * from the session itself; the tighten-only check runs
+					 * below, once the new value is known.
+					 */
+					if ((record->flags & GUC_RATCHET) && source == PGC_S_SESSION)
+					{
+						ratchet = true;
+						break;
+					}
 					/* No granted privilege */
 					ereport(elevel,
 							(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
@@ -3809,6 +3840,16 @@ set_config_with_handle(const char *name, config_handle *handle,
 					srole = record->reset_srole;
 				}
 
+				/* SwarmPG: a GUC_RATCHET budget may only be tightened */
+				if (ratchet && changeVal &&
+					!ratchet_tightens(record, (double) *conf->variable,
+									  (double) newval, elevel))
+				{
+					if (newextra && !extra_field_used(record, newextra))
+						guc_free(newextra);
+					return 0;
+				}
+
