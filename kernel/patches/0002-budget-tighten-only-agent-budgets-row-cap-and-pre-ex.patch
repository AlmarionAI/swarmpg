diff --git a/src/backend/utils/misc/guc.c b/src/backend/utils/misc/guc.c
index af44507..072171f 100644
--- a/src/backend/utils/misc/guc.c
+++ b/src/backend/utils/misc/guc.c
@@ -3297,6 +3297,26 @@ set_config_option_ext(const char *name, const char *value,
 }
 
 
+/*
+ * SwarmPG: may a session without permission to set a GUC_RATCHET budget move
+ * it from cur to newv?  Only toward a tighter limit; 0 means no limit.  This
+ * lets a frontend that is not a superuser lower an agent's budget per
+ * transaction while the agent, in the same session, cannot raise it again.
+ */
+static bool
+ratchet_tightens(struct config_generic *record, double cur, double newv,
+				 int elevel)
+{
+	if (cur == 0 || (newv != 0 && newv <= cur))
+		return true;
+	ereport(elevel,
+			(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+			 errmsg("parameter \"%s\" can only be lowered", record->name),
+			 errdetail("The current limit is %g. Raising it, or setting 0 (no limit), requires permission to set the parameter.",
+					   cur)));
+	return false;
+}
