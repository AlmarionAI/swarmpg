 Portal		ActivePortal = NULL;
 
+/*
+ * SwarmPG: the outermost executing portal owns the write budget.  SPI and
+ * SQL functions create separate EStates, and nested EXECUTE/FETCH can change
+ * ActivePortal, but none of them starts a new client statement.  The count
+ * lives in the portal so protocol-level suspension does not replenish it.
+ * These scopes must restore the pointer on ERROR as well as normal return.
+ */
+static Portal agentRowBudgetPortal = NULL;
+
+Portal
+BeginAgentRowBudget(Portal portal)
+{
+	Portal		previous = agentRowBudgetPortal;
+
+	if (previous == NULL)
+		agentRowBudgetPortal = portal;
+	return previous;
+}
+
+void
+RestoreAgentRowBudget(Portal previous)
+{
+	agentRowBudgetPortal = previous;
+}
+
+static void
+AgentRowBudgetError(int limit)
+{
+	ereport(ERROR,
+			(errcode(ERRCODE_CONFIGURATION_LIMIT_EXCEEDED),
+			 errmsg("statement would modify more rows than the agent row budget of %d",
+					limit),
+			 errhint("Modify fewer rows per statement, for example with a more selective WHERE clause.")));
+}
+
+void
+CheckAgentRowBudget(void)
+{
+	/* A PL/pgSQL exception handler must not turn a budget failure into success. */
+	if (agentRowBudgetPortal != NULL &&
+		agentRowBudgetPortal->agent_rows_exceeded != 0)
+		AgentRowBudgetError(agentRowBudgetPortal->agent_rows_exceeded);
+}
+
+void
+CountAgentRowModification(uint64 *fallback_rows)
+{
+	uint64	   *rows = agentRowBudgetPortal != NULL ?
+		&agentRowBudgetPortal->agent_rows_modified : fallback_rows;
+
+	CheckAgentRowBudget();
+	if (agent_max_rows <= 0)
+		return;
+
+	/* Retain executor-local accounting for server-internal, portal-less work. */
+	if (*rows < PG_UINT64_MAX)
+		(*rows)++;
+	if (*rows > (uint64) agent_max_rows)
+	{
+		if (agentRowBudgetPortal != NULL)
+			agentRowBudgetPortal->agent_rows_exceeded = agent_max_rows;
+		AgentRowBudgetError(agent_max_rows);
+	}
+}
