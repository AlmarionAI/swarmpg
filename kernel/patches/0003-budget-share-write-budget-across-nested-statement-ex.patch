 RESET agent_max_rows;
+-- nested SPI, SQL functions and trigger writes share the outer statement cap
+CREATE TABLE agent_budget_nested (id int);
+CREATE TABLE agent_budget_history (id int);
+CREATE FUNCTION agent_budget_record() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  INSERT INTO agent_budget_history VALUES (NEW.id);
+  RETURN NEW;
+END $$;
+CREATE TRIGGER agent_budget_record AFTER INSERT ON agent_budget_nested
+  FOR EACH ROW EXECUTE FUNCTION agent_budget_record();
+CREATE FUNCTION agent_budget_put(i int) RETURNS int LANGUAGE plpgsql AS $$
+BEGIN
+  INSERT INTO agent_budget_nested VALUES (i);
+  RETURN i;
+END $$;
+CREATE FUNCTION agent_budget_sql_put(i int) RETURNS int LANGUAGE sql AS $$
+  SELECT agent_budget_put(i)
+$$;
+CREATE FUNCTION agent_budget_catch() RETURNS int LANGUAGE plpgsql AS $$
+BEGIN
+  PERFORM agent_budget_put(40);
+  BEGIN
+    PERFORM sum(agent_budget_put(g)) FROM generate_series(1, 3) g;
+  EXCEPTION WHEN configuration_limit_exceeded THEN
+    RETURN 0;
+  END;
+  RETURN 1;
+END $$;
+SET agent_max_rows = 4;
+SELECT sum(agent_budget_sql_put(g)) FROM generate_series(1, 2) g; -- exactly four writes
+ sum 
+-----
+   3
+(1 row)
+
+SELECT (SELECT count(*) FROM agent_budget_nested) AS live,
+       (SELECT count(*) FROM agent_budget_history) AS history;
+ live | history 
+------+---------
+    2 |       2
+(1 row)
+
+TRUNCATE agent_budget_nested, agent_budget_history;
+\set VERBOSITY terse
+SELECT sum(agent_budget_put(g)) FROM generate_series(1, 3) g; -- one result, six writes
+ERROR:  statement would modify more rows than the agent row budget of 4
+\echo :SQLSTATE
+53400
+WITH d AS (INSERT INTO agent_budget_nested VALUES (10) RETURNING id)
+  SELECT sum(agent_budget_sql_put(g)) FROM generate_series(1, 2) g;
+ERROR:  statement would modify more rows than the agent row budget of 4
+\echo :SQLSTATE
+53400
+SELECT agent_budget_catch(); -- catching the inner error cannot commit the first write
+ERROR:  statement would modify more rows than the agent row budget of 4
+\echo :SQLSTATE
+53400
+DO $$ BEGIN PERFORM agent_budget_catch(); END $$; -- utility has no outer executor
+ERROR:  statement would modify more rows than the agent row budget of 4
+\echo :SQLSTATE
+53400
+PREPARE agent_budget_prepared AS
+  SELECT sum(agent_budget_put(g)) FROM generate_series(1, 3) g;
+EXECUTE agent_budget_prepared; -- a nested portal also inherits the budget
+ERROR:  statement would modify more rows than the agent row budget of 4
+\echo :SQLSTATE
+53400
+DEALLOCATE agent_budget_prepared;
+DECLARE agent_budget_held CURSOR WITH HOLD FOR
+  SELECT agent_budget_put(g) FROM generate_series(1, 3) g; -- materialization also shares a budget
+ERROR:  statement would modify more rows than the agent row budget of 4
+\echo :SQLSTATE
+53400
+\set VERBOSITY default
+SELECT (SELECT count(*) FROM agent_budget_nested) AS live,
+       (SELECT count(*) FROM agent_budget_history) AS history; -- both empty
+ live | history 
+------+---------
+    0 |       0
+(1 row)
+
+-- separate statements get fresh budgets, including after subtransaction abort
+SET agent_max_rows = 2;
+BEGIN;
+SELECT agent_budget_put(1);
+ agent_budget_put 
+------------------
+                1
+(1 row)
+
+SAVEPOINT agent_budget_save;
+\set VERBOSITY terse
+SELECT sum(agent_budget_put(g)) FROM generate_series(2, 3) g;
+ERROR:  statement would modify more rows than the agent row budget of 2
+\echo :SQLSTATE
+53400
+\set VERBOSITY default
+ROLLBACK TO agent_budget_save;
+SELECT agent_budget_put(2);
+ agent_budget_put 
+------------------
+                2
+(1 row)
+
+COMMIT;
+SELECT (SELECT count(*) FROM agent_budget_nested) AS live,
+       (SELECT count(*) FROM agent_budget_history) AS history; -- two each
+ live | history 
+------+---------
+    2 |       2
+(1 row)
+
+RESET agent_max_rows;
+DROP FUNCTION agent_budget_catch();
+DROP FUNCTION agent_budget_sql_put(int);
+DROP FUNCTION agent_budget_put(int);
+DROP TABLE agent_budget_nested;
+DROP FUNCTION agent_budget_record();
+DROP TABLE agent_budget_history;
 -- cost budget: an over-budget plan is refused before it runs
