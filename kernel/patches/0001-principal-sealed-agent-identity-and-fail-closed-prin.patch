 	/* caller must ensure the query's snapshot is active */
 	Assert(GetActiveSnapshot() == queryDesc->snapshot);
 
+	/*
+	 * SwarmPG: fail-closed principal check.  When agent_require_principal is on
+	 * (set per pool role, PGC_SUSET so the agent cannot clear it), no query
+	 * plan may run until the sealed agent_id has been established for this
+	 * session or transaction.  This defends the RLS-protected data paths even
+	 * if the frontend ever hands out a backend without sealing, or an abort
+	 * clears a session-scoped seal: a subsequent unsealed read errors out
+	 * instead of returning another principal's rows.
+	 */
+	if (agent_require_principal &&
