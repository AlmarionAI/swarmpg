diff --git a/src/test/regress/expected/agent_identity.out b/src/test/regress/expected/agent_identity.out
new file mode 100644
index 0000000..b5043b0
--- /dev/null
+++ b/src/test/regress/expected/agent_identity.out
@@ -0,0 +1,200 @@
+--
+-- SwarmPG: sealed agent identity (agent_id GUC with GUC_SEALED, current_agent())
+--
+SHOW agent_id;
+ agent_id 
+----------
+ 
+(1 row)
+
+SELECT current_agent() IS NULL AS unset;
+ unset 
+-------
+ t
+(1 row)
+
+SELECT 'SEALED' = ANY(pg_settings_get_flags('agent_id')) AS sealed_flag;
+ sealed_flag 
+-------------
+ t
+(1 row)
+
+-- a function SET clause is validated at creation, so create it while unsealed
+CREATE FUNCTION agent_identity_fn() RETURNS text LANGUAGE sql
+  SET agent_id = 'fn' AS 'SELECT current_agent()';
+-- session-level seal: nothing may change or clear it
+SET agent_id = 'agent-A';
+SHOW agent_id;
+ agent_id 
+----------
+ agent-A
+(1 row)
+
+SELECT current_agent();
+ current_agent 
+---------------
+ agent-A
+(1 row)
+
+SET agent_id = 'agent-A';          -- fails: even an identical re-assignment is refused
+ERROR:  parameter "agent_id" is sealed and cannot be changed or reset
+DETAIL:  It is already set to "agent-A" for this session or transaction.
+SET agent_id = 'agent-B';          -- fails
+ERROR:  parameter "agent_id" is sealed and cannot be changed or reset
+DETAIL:  It is already set to "agent-A" for this session or transaction.
+RESET agent_id;                    -- fails
+ERROR:  parameter "agent_id" is sealed and cannot be changed or reset
+DETAIL:  It is already set to "agent-A" for this session or transaction.
+SELECT set_config('agent_id', 'agent-C', false);   -- fails
+ERROR:  parameter "agent_id" is sealed and cannot be changed or reset
+DETAIL:  It is already set to "agent-A" for this session or transaction.
+SELECT set_config('agent_id', 'agent-C', true);    -- fails
+ERROR:  parameter "agent_id" is sealed and cannot be changed or reset
+DETAIL:  It is already set to "agent-A" for this session or transaction.
+DO $$ BEGIN PERFORM set_config('agent_id', 'agent-D', true); END $$;  -- fails
+ERROR:  parameter "agent_id" is sealed and cannot be changed or reset
+DETAIL:  It is already set to "agent-A" for this session or transaction.
+CONTEXT:  SQL statement "SELECT set_config('agent_id', 'agent-D', true)"
+PL/pgSQL function inline_code_block line 1 at PERFORM
+RESET ALL;                         -- skips agent_id (GUC_NO_RESET_ALL)
+DISCARD ALL;                       -- likewise
+SHOW agent_id;
+ agent_id 
+----------
+ agent-A
+(1 row)
+
+-- a function SET clause is a SAVE action and is refused while sealed
+SELECT agent_identity_fn();        -- fails
+ERROR:  parameter "agent_id" is sealed and cannot be changed or reset
+DETAIL:  It is already set to "agent-A" for this session or transaction.
+SELECT current_agent();
+ current_agent 
+---------------
+ agent-A
+(1 row)
+
+-- transaction-local seal reverts at commit and abort through the GUC stack
+\c
+SHOW agent_id;
+ agent_id 
+----------
+ 
+(1 row)
+
+BEGIN;
+SET LOCAL agent_id = 'txn-1';
+SELECT current_agent();
+ current_agent 
+---------------
+ txn-1
+(1 row)
+
+SAVEPOINT s;
+SET LOCAL agent_id = 'txn-2';      -- fails: sealed within the transaction
+ERROR:  parameter "agent_id" is sealed and cannot be changed or reset
+DETAIL:  It is already set to "txn-1" for this session or transaction.
+ROLLBACK TO s;
+SELECT current_agent();
+ current_agent 
+---------------
+ txn-1
+(1 row)
+
+COMMIT;
+SELECT current_agent() IS NULL AS unset_after_commit;
+ unset_after_commit 
+--------------------
+ t
+(1 row)
+
+BEGIN;
+SET LOCAL agent_id = 'txn-3';
+SELECT current_agent();
+ current_agent 
+---------------
+ txn-3
+(1 row)
+
+ROLLBACK;
+SELECT current_agent() IS NULL AS unset_after_rollback;
+ unset_after_rollback 
+----------------------
+ t
+(1 row)
+
+-- after a transaction-local seal ends, a new identity may be established
+BEGIN;
+SET LOCAL agent_id = 'txn-4';
+SELECT current_agent();
+ current_agent 
+---------------
+ txn-4
+(1 row)
+
+COMMIT;
+-- a function SET clause while unsealed applies for the call only
+SELECT agent_identity_fn();
+ agent_identity_fn 
+-------------------
+ fn
+(1 row)
+
+SELECT current_agent() IS NULL AS unset_after_fn;
+ unset_after_fn 
+----------------
+ t
+(1 row)
+
+DROP FUNCTION agent_identity_fn();
+-- not settable from a configuration file
+ALTER SYSTEM SET agent_id = 'x';
+ERROR:  parameter "agent_id" cannot be changed
+-- a sealed parameter may only be ESTABLISHED by the session itself. A per-role
+-- default can be STORED (ALTER ROLE ... SET is not validated against the live
+-- value), but it is refused when a session tries to APPLY it at connect, so the
+-- session starts unsealed and the pool cannot be pre-sealed out from under the
+-- frontend. (Verified out-of-band: a new session of such a role shows agent_id
+-- empty and can still seal normally.)
+CREATE ROLE regress_agent_seal;
+ALTER ROLE regress_agent_seal SET agent_id = 'from-role-default';   -- stored, inert
+DROP ROLE regress_agent_seal;
+-- pg_settings_get_flags reports SEALED alongside the other flags without
+-- overrunning its fixed-size array (regression guard for MAX_GUC_FLAGS).
+SELECT array_length(pg_settings_get_flags('agent_id'), 1) AS nflags;
+ nflags 
+--------
+      3
+(1 row)
+
+SELECT 'SEALED' = ANY(pg_settings_get_flags('agent_id')) AS has_sealed;
+ has_sealed 
+------------
+ t
+(1 row)
+
+-- fail-closed mode: with agent_require_principal on and no principal, query
+-- execution is refused; establishing the principal unblocks it.
+SET agent_require_principal = on;
+SELECT 1 AS blocked;                 -- fails: no agent principal established
+ERROR:  no agent principal established
+DETAIL:  agent_require_principal is on and agent_id is not set for this session or transaction.
+BEGIN;
+SET LOCAL agent_id = 'txn-rp';
+SELECT 1 AS allowed_with_principal;  -- succeeds inside the sealed scope
+ allowed_with_principal 
+------------------------
+                      1
+(1 row)
+
+COMMIT;
+SELECT 1 AS blocked_again;           -- fails again after the scope ends
+ERROR:  no agent principal established
+DETAIL:  agent_require_principal is on and agent_id is not set for this session or transaction.
+SET agent_require_principal = off;
+SELECT 1 AS allowed_after_off;
+ allowed_after_off 
+-------------------
+                 1
+(1 row)
+
