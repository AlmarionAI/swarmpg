diff --git a/src/backend/utils/misc/guc.c b/src/backend/utils/misc/guc.c
index 774bbc9..af44507 100644
--- a/src/backend/utils/misc/guc.c
+++ b/src/backend/utils/misc/guc.c
@@ -3562,6 +3562,76 @@ set_config_with_handle(const char *name, config_handle *handle,
 		}
 	}
 
+	/*
+	 * SwarmPG: sealing of a GUC_SEALED variable (e.g. the agent principal).
+	 *
+	 * Two rules, enforced at the single funnel that SET, SET LOCAL, RESET,
+	 * set_config() and function SET clauses all pass through:
+	 *
+	 * 1. ESTABLISHMENT.  A sealed variable may only be *established* by the
+	 *    connected session itself (PGC_S_SESSION, i.e. an explicit SET from the
+	 *    frontend), by the forced-default path (PGC_S_DEFAULT/PGC_S_OVERRIDE),
+	 *    or by parallel/background-worker state restore (is_reload, which copies
+	 *    the leader's already-sealed value).  Every non-interactive source is
+	 *    refused: per-role and per-database defaults (ALTER ROLE/DATABASE SET,
+	 *    sources PGC_S_GLOBAL..PGC_S_DATABASE_USER), the postmaster command line
+	 *    and environment (PGC_S_ARGV/PGC_S_ENV_VAR), and the startup packet /
+	 *    PGOPTIONS (PGC_S_CLIENT).  This stops an operator or a poisoned role
+	 *    default from pre-sealing every pooled connection, which would both lock
+	 *    the frontend out and let it run every agent under one forced identity.
+	 *    (GUC_DISALLOW_IN_FILE already covers postgresql.conf / ALTER SYSTEM.)
+	 *
+	 * 2. IMMUTABILITY.  Once it holds a non-empty value, no assignment, reset or
+	 *    save of any kind succeeds; only the GUC stack unwinding at the end of a
+	 *    SET LOCAL scope or function-call scope (which does not pass through
+	 *    here) can clear it.  This is what makes the identity trustworthy against
+	 *    arbitrary SQL issued by the agent in the same session or transaction.
+	 *
+	 * changeVal == false means this is a validation-only probe (PGC_S_TEST,
+	 * e.g. checking an ALTER ROLE ... SET clause at definition time, or the
+	 * two-pass assignment of a value).  We still reject establishment from a
+	 * disallowed source so the error surfaces at definition time, but we do not
+	 * raise the "already sealed" immutability error on a mere probe, which would
+	 * otherwise make ALTER ... RESET and routine re-validation fail confusingly.
+	 *
+	 * Only string variables support sealing for now; a non-string GUC_SEALED
+	 * variable is a programming error, so flag it in assert builds.
+	 */
+	if (record->flags & GUC_SEALED)
+	{
+		const char *cur;
+
+		Assert(record->vartype == PGC_STRING);
+
+		/* Rule 1: restrict who may establish the seal. */
+		if (changeVal && value != NULL && value[0] != '\0' &&
+			source != PGC_S_SESSION &&
+			source != PGC_S_DEFAULT &&
+			source != PGC_S_OVERRIDE &&
+			!is_reload)
+		{
+			ereport(elevel,
+					(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+					 errmsg("sealed parameter \"%s\" can only be set by the session itself",
+							record->name),
+					 errdetail("It cannot be set from a role or database default, the server command line, the environment, or the startup packet.")));
+			return 0;
+		}
+
+		/* Rule 2: once established, it is immutable for its scope. */
+		cur = (record->vartype == PGC_STRING) ? *record->_string.variable : NULL;
+		if (changeVal && cur != NULL && cur[0] != '\0')
+		{
+			ereport(elevel,
+					(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+					 errmsg("parameter \"%s\" is sealed and cannot be changed or reset",
+							record->name),
+					 errdetail("It is already set to \"%s\" for this session or transaction.",
+							   cur)));
+			return 0;
+		}
+	}
+
 	/* Disallow resetting and saving GUC_NO_RESET values */
 	if (record->flags & GUC_NO_RESET)
 	{
