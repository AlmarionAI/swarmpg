+{ name => 'agent_id', type => 'string', context => 'PGC_USERSET', group => 'CLIENT_CONN_STATEMENT',
+  short_desc => 'Sets the sealed agent identity for this session or transaction.',
+  long_desc => 'Can only be set while empty. Once set it cannot be changed or reset until the enclosing SET LOCAL scope ends.',
+  flags => 'GUC_SEALED | GUC_NO_RESET_ALL | GUC_NOT_IN_SAMPLE | GUC_DISALLOW_IN_FILE | GUC_NOT_WHILE_SEC_REST',
+  variable => 'agent_id_string',
+  boot_val => '""',
+},
+
+# SwarmPG: fail-closed switch.  When on, a backend refuses to execute a query
+# plan unless a principal (agent_id) has been established.  PGC_SUSET so an
+# agent connected as a non-superuser cannot clear it; set it per pool role with
+# ALTER ROLE <role> SET agent_require_principal = on.
+{ name => 'agent_require_principal', type => 'bool', context => 'PGC_SUSET', group => 'CLIENT_CONN_STATEMENT',
+  short_desc => 'Refuse to execute queries until an agent principal is established.',
+  long_desc => 'When on, any query plan execution errors out while current_agent() is NULL. Intended for pooled backends that run untrusted agent SQL.',
+  flags => 'GUC_NO_RESET_ALL | GUC_NOT_IN_SAMPLE',
+  variable => 'agent_require_principal',
+  boot_val => 'false',
+},
+
 { name => 'allow_alter_system', type => 'bool', context => 'PGC_SIGHUP', group => 'COMPAT_OPTIONS_OTHER',
   short_desc => 'Allows running the ALTER SYSTEM command.',
   long_desc => 'Can be set to off for environments where global configuration changes should be made using a different method.',
