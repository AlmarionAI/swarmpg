diff --git a/src/backend/utils/misc/agent_principal.c b/src/backend/utils/misc/agent_principal.c
new file mode 100644
index 0000000..4051141
--- /dev/null
+++ b/src/backend/utils/misc/agent_principal.c
@@ -0,0 +1,255 @@
+/*-------------------------------------------------------------------------
+ *
+ * agent_principal.c
+ *	  SwarmPG: the sealed agent principal.
+ *
+ * The principal is one GUC_SEALED string, agent_principal, that names the
+ * agent and its org together:
+ *
+ *		agent=<id>,org=<id>[,sig=<hex>]
+ *
+ * Carrying both fields in one value is what seals them as a group: they are
+ * established by a single assignment and are immutable together (see the
+ * GUC_SEALED rules in guc.c), so a frontend can never leave a half-set
+ * principal for the agent to complete.  An id is 1 to 63 characters from
+ * [A-Za-z0-9_.:-], and the fields must appear in exactly this order, so the
+ * signed payload has one canonical spelling.
+ *
+ * When agent_principal_secret is set, the value must also carry
+ * sig = lowercase hex(HMAC-SHA256(secret, "agent=<id>,org=<id>")).  A session
+ * that does not know the secret then cannot establish any principal at all,
+ * even if the frontend never sealed one.  The secret is superuser-only and
+ * can only come from the server configuration or a superuser's own session.
+ *
+ * Portions Copyright (c) 2026, AlmarionAI
+ * Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group
+ *
+ * IDENTIFICATION
+ *	  src/backend/utils/misc/agent_principal.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include "access/parallel.h"
+#include "common/hmac.h"
+#include "common/sha2.h"
+#include "fmgr.h"
+#include "utils/agent_principal.h"
+#include "utils/builtins.h"
+#include "utils/guc.h"
+#include "utils/guc_hooks.h"
+
+#define PRINCIPAL_ID_MAX	63
+#define PRINCIPAL_SIG_HEX	(PG_SHA256_DIGEST_LENGTH * 2)
+
+typedef struct AgentPrincipal
+{
+	char		agent[PRINCIPAL_ID_MAX + 1];
+	char		org[PRINCIPAL_ID_MAX + 1];
+} AgentPrincipal;
+
+/* The established principal (the GUC's "extra"), or NULL when none. */
+static const AgentPrincipal *current_principal = NULL;
+
+/*
+ * Parse "<key>=<id>" at *p into dst and advance *p past it.
+ */
+static bool
+parse_principal_field(const char **p, const char *key, char *dst)
+{
+	const char *s = *p;
+	size_t		klen = strlen(key);
+	size_t		n = 0;
+
+	if (strncmp(s, key, klen) != 0 || s[klen] != '=')
+		return false;
+	s += klen + 1;
+	while ((*s >= 'a' && *s <= 'z') || (*s >= 'A' && *s <= 'Z') ||
+		   (*s >= '0' && *s <= '9') ||
+		   *s == '_' || *s == '.' || *s == ':' || *s == '-')
+	{
+		if (n == PRINCIPAL_ID_MAX)
+			return false;
+		dst[n++] = *s++;
+	}
+	if (n == 0)
+		return false;
+	dst[n] = '\0';
+	*p = s;
+	return true;
+}
+
+/*
+ * Does sig equal the HMAC-SHA256 of payload[0..len) under the secret?
+ * Compared in constant time; any HMAC failure counts as a mismatch.
+ */
+static bool
+principal_signature_matches(const char *payload, size_t len, const char *sig)
+{
+	pg_hmac_ctx *ctx;
+	uint8		digest[PG_SHA256_DIGEST_LENGTH];
+	char		expected[PRINCIPAL_SIG_HEX];
+	bool		ok = false;
+
+	if (strlen(sig) != PRINCIPAL_SIG_HEX)
+		return false;
+
+	ctx = pg_hmac_create(PG_SHA256);
+	if (ctx == NULL)
+		return false;
+	if (pg_hmac_init(ctx, (const uint8 *) agent_principal_secret,
+					 strlen(agent_principal_secret)) == 0 &&
+		pg_hmac_update(ctx, (const uint8 *) payload, len) == 0 &&
+		pg_hmac_final(ctx, digest, sizeof(digest)) == 0)
+	{
+		hex_encode((const char *) digest, sizeof(digest), expected);
+		ok = timingsafe_bcmp(expected, sig, PRINCIPAL_SIG_HEX) == 0;
+	}
+	pg_hmac_free(ctx);
+	explicit_bzero(digest, sizeof(digest));
+	explicit_bzero(expected, sizeof(expected));
+	return ok;
+}
+
+static bool
+principal_format_error(void)
+{
+	GUC_check_errcode(ERRCODE_INVALID_PARAMETER_VALUE);
+	GUC_check_errmsg("invalid agent principal");
+	GUC_check_errdetail("Expected \"agent=<id>,org=<id>\", optionally followed by \",sig=<hex>\". Both agent and org are required; an id is 1 to %d characters from [A-Za-z0-9_.:-].",
+						PRINCIPAL_ID_MAX);
+	return false;
+}
+
+bool
+check_agent_principal(char **newval, void **extra, GucSource source)
+{
+	AgentPrincipal parsed;
+	AgentPrincipal *result;
+	const char *p = *newval;
+	const char *payload_end;
+	const char *sig = NULL;
+	bool		have_secret;
+
+	/* Empty means "no principal"; guc.c decides when that is allowed. */
+	if (p == NULL || p[0] == '\0')
+	{
+		*extra = NULL;
+		return true;
+	}
+
+	if (!parse_principal_field(&p, "agent", parsed.agent) || *p++ != ',' ||
+		!parse_principal_field(&p, "org", parsed.org))
+		return principal_format_error();
+	payload_end = p;
+	if (strncmp(p, ",sig=", 5) == 0)
+		sig = p + 5;
+	else if (*p != '\0')
+		return principal_format_error();
+
+	/*
+	 * A parallel worker restores the leader's already-verified principal,
+	 * possibly before the secret itself has been restored, so it does not
+	 * re-verify.
+	 */
+	have_secret = agent_principal_secret != NULL && agent_principal_secret[0] != '\0';
+	if (!InitializingParallelWorker)
+	{
+		if (have_secret && sig == NULL)
+		{
+			GUC_check_errcode(ERRCODE_INSUFFICIENT_PRIVILEGE);
+			GUC_check_errmsg("agent principal is not signed");
+			GUC_check_errdetail("agent_principal_secret is set, so the principal must end with \",sig=<hex>\".");
+			return false;
+		}
+		if (have_secret &&
+			!principal_signature_matches(*newval, payload_end - *newval, sig))
+		{
+			GUC_check_errcode(ERRCODE_INSUFFICIENT_PRIVILEGE);
+			GUC_check_errmsg("invalid agent principal signature");
+			return false;
+		}
+		if (!have_secret && sig != NULL)
+		{
+			/* Fail closed: a signing frontend means the server is misconfigured. */
+			GUC_check_errcode(ERRCODE_INVALID_PARAMETER_VALUE);
+			GUC_check_errmsg("agent principal is signed but agent_principal_secret is not set");
+			return false;
+		}
+	}
+
+	result = (AgentPrincipal *) guc_malloc(LOG, sizeof(AgentPrincipal));
+	if (result == NULL)
+		return false;
+	memcpy(result, &parsed, sizeof(AgentPrincipal));
+	*extra = result;
+	return true;
+}
+
+void
+assign_agent_principal(const char *newval, void *extra)
+{
+	current_principal = (const AgentPrincipal *) extra;
+}
+
+/*
+ * The secret may only come from the server configuration (postgresql.conf,
+ * ALTER SYSTEM, the command line) or a superuser's own session: never from a
+ * per-role or per-database default, which would store it in a catalog, nor
+ * from the startup packet.
+ */
+bool
+check_agent_principal_secret(char **newval, void **extra, GucSource source)
+{
+	if (*newval == NULL || (*newval)[0] == '\0')
+		return true;
+	switch (source)
+	{
+		case PGC_S_GLOBAL:
+		case PGC_S_DATABASE:
+		case PGC_S_USER:
+		case PGC_S_DATABASE_USER:
+		case PGC_S_CLIENT:
+		case PGC_S_TEST:
+			GUC_check_errcode(ERRCODE_INSUFFICIENT_PRIVILEGE);
+			GUC_check_errmsg("agent_principal_secret can only be set in the server configuration");
+			return false;
+		default:
+			return true;
+	}
+}
+
+const char *
+GetAgentPrincipalAgent(void)
+{
+	return current_principal ? current_principal->agent : NULL;
+}
+
+const char *
+GetAgentPrincipalOrg(void)
+{
+	return current_principal ? current_principal->org : NULL;
+}
+
+/*
+ * current_agent() -- the agent id of the sealed principal, or NULL.
+ */
+Datum
+current_agent(PG_FUNCTION_ARGS)
+{
+	if (current_principal == NULL)
+		PG_RETURN_NULL();
+	PG_RETURN_TEXT_P(cstring_to_text(current_principal->agent));
+}
+
+/*
+ * current_org() -- the org id of the sealed principal, or NULL.
+ */
+Datum
+current_org(PG_FUNCTION_ARGS)
+{
+	if (current_principal == NULL)
+		PG_RETURN_NULL();
+	PG_RETURN_TEXT_P(cstring_to_text(current_principal->org));
+}
diff --git a/src/backend/utils/misc/guc.c b/src/backend/utils/misc/guc.c
index 774bbc9..af44507 100644
--- a/src/backend/utils/misc/guc.c
+++ b/src/backend/utils/misc/guc.c
@@ -3562,6 +3562,76 @@ set_config_with_handle(const char *name, config_handle *handle,
 		}
 	}
 
+	/*
+	 * SwarmPG: sealing of a GUC_SEALED variable (e.g. the agent principal).
+	 *
+	 * Two rules, enforced at the single funnel that SET, SET LOCAL, RESET,
+	 * set_config() and function SET clauses all pass through:
+	 *
+	 * 1. ESTABLISHMENT.  A sealed variable may only be *established* by the
+	 *    connected session itself (PGC_S_SESSION, i.e. an explicit SET from the
+	 *    frontend), by the forced-default path (PGC_S_DEFAULT/PGC_S_OVERRIDE),
+	 *    or by parallel/background-worker state restore (is_reload, which copies
+	 *    the leader's already-sealed value).  Every non-interactive source is
+	 *    refused: per-role and per-database defaults (ALTER ROLE/DATABASE SET,
+	 *    sources PGC_S_GLOBAL..PGC_S_DATABASE_USER), the postmaster command line
+	 *    and environment (PGC_S_ARGV/PGC_S_ENV_VAR), and the startup packet /
+	 *    PGOPTIONS (PGC_S_CLIENT).  This stops an operator or a poisoned role
+	 *    default from pre-sealing every pooled connection, which would both lock
+	 *    the frontend out and let it run every agent under one forced identity.
+	 *    (GUC_DISALLOW_IN_FILE already covers postgresql.conf / ALTER SYSTEM.)
+	 *
+	 * 2. IMMUTABILITY.  Once it holds a non-empty value, no assignment, reset or
+	 *    save of any kind succeeds; only the GUC stack unwinding at the end of a
+	 *    SET LOCAL scope or function-call scope (which does not pass through
+	 *    here) can clear it.  This is what makes the identity trustworthy against
+	 *    arbitrary SQL issued by the agent in the same session or transaction.
+	 *
+	 * changeVal == false means this is a validation-only probe (PGC_S_TEST,
+	 * e.g. checking an ALTER ROLE ... SET clause at definition time, or the
+	 * two-pass assignment of a value).  We still reject establishment from a
+	 * disallowed source so the error surfaces at definition time, but we do not
+	 * raise the "already sealed" immutability error on a mere probe, which would
+	 * otherwise make ALTER ... RESET and routine re-validation fail confusingly.
+	 *
+	 * Only string variables support sealing for now; a non-string GUC_SEALED
+	 * variable is a programming error, so flag it in assert builds.
+	 */
+	if (record->flags & GUC_SEALED)
+	{
+		const char *cur;
+
+		Assert(record->vartype == PGC_STRING);
+
+		/* Rule 1: restrict who may establish the seal. */
+		if (changeVal && value != NULL && value[0] != '\0' &&
+			source != PGC_S_SESSION &&
+			source != PGC_S_DEFAULT &&
+			source != PGC_S_OVERRIDE &&
+			!is_reload)
+		{
+			ereport(elevel,
+					(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+					 errmsg("sealed parameter \"%s\" can only be set by the session itself",
+							record->name),
+					 errdetail("It cannot be set from a role or database default, the server command line, the environment, or the startup packet.")));
+			return 0;
+		}
+
+		/* Rule 2: once established, it is immutable for its scope. */
+		cur = (record->vartype == PGC_STRING) ? *record->_string.variable : NULL;
+		if (changeVal && cur != NULL && cur[0] != '\0')
+		{
+			ereport(elevel,
+					(errcode(ERRCODE_INSUFFICIENT_PRIVILEGE),
+					 errmsg("parameter \"%s\" is sealed and cannot be changed or reset",
+							record->name),
+					 errdetail("It is already set to \"%s\" for this session or transaction.",
+							   cur)));
+			return 0;
+		}
+	}
+
 	/* Disallow resetting and saving GUC_NO_RESET values */
 	if (record->flags & GUC_NO_RESET)
 	{
