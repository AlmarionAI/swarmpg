 # This setting itself cannot be set by ALTER SYSTEM to avoid an
 # operator turning this setting off by using ALTER SYSTEM, without a
 # way to turn it back on.
+# SwarmPG: the sealed agent principal, "agent=<id>,org=<id>[,sig=<hex>]".
+# Agent and org are established by one assignment and sealed together.
+{ name => 'agent_principal', type => 'string', context => 'PGC_USERSET', group => 'CLIENT_CONN_STATEMENT',
+  short_desc => 'Sets the sealed agent principal (agent and org) for this session or transaction.',
+  long_desc => 'Format agent=<id>,org=<id>, plus ,sig=<hex> when agent_principal_secret is set. Can only be set while empty; once set it cannot be changed or reset until the enclosing SET LOCAL scope ends.',
+  flags => 'GUC_SEALED | GUC_NO_RESET_ALL | GUC_NOT_IN_SAMPLE | GUC_DISALLOW_IN_FILE | GUC_NOT_WHILE_SEC_REST',
+  variable => 'agent_principal_string',
+  boot_val => '""',
+  check_hook => 'check_agent_principal',
+  assign_hook => 'assign_agent_principal',
+},
+
+# SwarmPG: HMAC-SHA256 key that agent_principal values must be signed with.
+# Superuser-only; never accepted from a role/database default or the startup
+# packet, so it is never stored in a catalog.
+{ name => 'agent_principal_secret', type => 'string', context => 'PGC_SUSET', group => 'CLIENT_CONN_STATEMENT',
+  short_desc => 'Sets the key that agent principals must be signed with.',
+  long_desc => 'When set, agent_principal must carry sig = hex(HMAC-SHA256(key, "agent=<id>,org=<id>")). Empty means principals are not signed.',
+  flags => 'GUC_SUPERUSER_ONLY | GUC_NO_SHOW_ALL | GUC_NO_RESET_ALL | GUC_NOT_IN_SAMPLE',
+  variable => 'agent_principal_secret',
+  boot_val => '""',
+  check_hook => 'check_agent_principal_secret',
+},
+
+# SwarmPG: fail-closed switch.  When on, a backend refuses to execute a query
+# plan unless a principal (agent_principal) has been established.  PGC_SUSET so an
+# agent connected as a non-superuser cannot clear it; set it per pool role with
+# ALTER ROLE <role> SET agent_require_principal = on.
+{ name => 'agent_require_principal', type => 'bool', context => 'PGC_SUSET', group => 'CLIENT_CONN_STATEMENT',
+  short_desc => 'Refuse to execute queries until an agent principal is established.',
+  long_desc => 'When on, any query plan execution errors out while current_agent() is NULL. Intended for pooled backends that run untrusted agent SQL.',
+  flags => 'GUC_NO_RESET_ALL | GUC_NOT_IN_SAMPLE',
+  variable => 'agent_require_principal',
+  boot_val => 'false',
+},
+
 { name => 'allow_alter_system', type => 'bool', context => 'PGC_SIGHUP', group => 'COMPAT_OPTIONS_OTHER',
   short_desc => 'Allows running the ALTER SYSTEM command.',
   long_desc => 'Can be set to off for environments where global configuration changes should be made using a different method.',
