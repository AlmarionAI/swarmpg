diff --git a/src/test/regress/sql/agent_identity.sql b/src/test/regress/sql/agent_identity.sql
new file mode 100644
index 0000000..f86cf98
--- /dev/null
+++ b/src/test/regress/sql/agent_identity.sql
@@ -0,0 +1,122 @@
+--
+-- SwarmPG: sealed agent principal (agent_principal GUC with GUC_SEALED,
+-- current_agent(), current_org())
+--
+SHOW agent_principal;
+SELECT current_agent() IS NULL AND current_org() IS NULL AS unset;
+SELECT 'SEALED' = ANY(pg_settings_get_flags('agent_principal')) AS sealed_flag;
+-- a function SET clause is validated at creation, so create it while unsealed
+CREATE FUNCTION agent_identity_fn() RETURNS text LANGUAGE sql
+  SET agent_principal = 'agent=fn,org=fn-org' AS 'SELECT current_agent()';
+
+-- agent and org are one value: a half-set or malformed principal is refused
+SET agent_principal = 'agent=agent-A';                 -- fails: org missing
+SET agent_principal = 'org=org-1';                     -- fails: agent missing
+SET agent_principal = 'org=org-1,agent=agent-A';       -- fails: wrong order
+SET agent_principal = 'agent=agent-A,org=';            -- fails: empty org
+SET agent_principal = 'agent=agent A,org=org-1';       -- fails: bad character
+SET agent_principal = 'agent=agent-A,org=org-1,x=1';   -- fails: unknown field
+SET agent_principal = 'agent=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,org=o';  -- fails: id too long
+SET agent_principal = 'agent=agent-A,org=org-1,sig=00';  -- fails: signed, but no secret is set
+SELECT current_agent() IS NULL AS still_unset;
+
+-- session-level seal: nothing may change or clear it, nor either half of it
+SET agent_principal = 'agent=agent-A,org=org-1';
+SHOW agent_principal;
+SELECT current_agent(), current_org();
+SET agent_principal = 'agent=agent-A,org=org-1';    -- fails: even an identical re-assignment is refused
+SET agent_principal = 'agent=agent-A,org=org-2';    -- fails: the org cannot be changed
+SET agent_principal = 'agent=agent-B,org=org-1';    -- fails
+RESET agent_principal;                              -- fails
+SELECT set_config('agent_principal', 'agent=agent-C,org=org-1', false);  -- fails
+SELECT set_config('agent_principal', 'agent=agent-C,org=org-1', true);   -- fails
+DO $$ BEGIN PERFORM set_config('agent_principal', 'agent=agent-D,org=org-1', true); END $$;  -- fails
+RESET ALL;                         -- skips agent_principal (GUC_NO_RESET_ALL)
+DISCARD ALL;                       -- likewise
+SHOW agent_principal;
+-- a function SET clause is a SAVE action and is refused while sealed
+SELECT agent_identity_fn();        -- fails
+SELECT current_agent(), current_org();
+
+-- transaction-local seal reverts at commit and abort through the GUC stack
+\c
+SHOW agent_principal;
+BEGIN;
+SET LOCAL agent_principal = 'agent=txn-1,org=org-1';
+SELECT current_agent(), current_org();
+SAVEPOINT s;
+SET LOCAL agent_principal = 'agent=txn-1,org=org-2';   -- fails: sealed within the transaction
+ROLLBACK TO s;
+SELECT current_agent(), current_org();
+COMMIT;
+SELECT current_agent() IS NULL AND current_org() IS NULL AS unset_after_commit;
+BEGIN;
+SET LOCAL agent_principal = 'agent=txn-3,org=org-1';
+SELECT current_agent();
+ROLLBACK;
+SELECT current_agent() IS NULL AS unset_after_rollback;
+-- after a transaction-local seal ends, a new principal may be established
+BEGIN;
+SET LOCAL agent_principal = 'agent=txn-4,org=org-4';
+SELECT current_agent(), current_org();
+COMMIT;
+-- a function SET clause while unsealed applies for the call only
+SELECT agent_identity_fn();
+SELECT current_agent() IS NULL AS unset_after_fn;
+DROP FUNCTION agent_identity_fn();
+-- not settable from a configuration file
+ALTER SYSTEM SET agent_principal = 'agent=x,org=y';
+
+-- a sealed parameter may only be ESTABLISHED by the session itself. A per-role
+-- default can be STORED (ALTER ROLE ... SET is not validated against the live
+-- value), but it is refused when a session tries to APPLY it at connect, so the
+-- session starts unsealed and the pool cannot be pre-sealed out from under the
+-- frontend.
+CREATE ROLE regress_agent_seal;
+ALTER ROLE regress_agent_seal SET agent_principal = 'agent=from-role,org=o';   -- stored, inert
+DROP ROLE regress_agent_seal;
+
+-- pg_settings_get_flags reports SEALED alongside the other flags without
+-- overrunning its fixed-size array (regression guard for MAX_GUC_FLAGS).
+SELECT array_length(pg_settings_get_flags('agent_principal'), 1) AS nflags;
+SELECT 'SEALED' = ANY(pg_settings_get_flags('agent_principal')) AS has_sealed;
+
+-- signed principals: with agent_principal_secret set, only a principal that
+-- carries a valid HMAC-SHA256 signature can be established
+SET agent_principal_secret = 'regress-secret';
+BEGIN;
+SET LOCAL agent_principal = 'agent=agent-S,org=org-S';   -- fails: not signed
+ROLLBACK;
+BEGIN;
+-- fails: the signature of agent-T presented for agent-S
+SET LOCAL agent_principal = 'agent=agent-S,org=org-S,sig=7454eebe5c87b3851d49a2764a7e536be558937711190a043c00847965cc832b';
+ROLLBACK;
+BEGIN;
+SET LOCAL agent_principal = 'agent=agent-S,org=org-S,sig=6CD17AB9638807239E2249313D4AC5B1287CEF0AC312211676407EA010BEC4DD';  -- fails: uppercase hex
+ROLLBACK;
+BEGIN;
+SET LOCAL agent_principal = 'agent=agent-S,org=org-S,sig=6cd17ab9638807239e2249313d4ac5b1287cef0ac312211676407ea010bec4dd';
+SELECT current_agent(), current_org();
+COMMIT;
+RESET agent_principal_secret;
+
+-- the secret is superuser-only and never stored in a catalog
+CREATE ROLE regress_agent_nosu;
+ALTER ROLE regress_agent_nosu SET agent_principal_secret = 'k';  -- fails: catalog source
+SET ROLE regress_agent_nosu;
+SHOW agent_principal_secret;           -- fails: superuser only
+SET agent_principal_secret = 'k';      -- fails: permission denied
+RESET ROLE;
+DROP ROLE regress_agent_nosu;
+
+-- fail-closed mode: with agent_require_principal on and no principal, query
+-- execution is refused; establishing the principal unblocks it.
+SET agent_require_principal = on;
+SELECT 1 AS blocked;                 -- fails: no agent principal established
+BEGIN;
+SET LOCAL agent_principal = 'agent=txn-rp,org=org-rp';
+SELECT 1 AS allowed_with_principal;  -- succeeds inside the sealed scope
+COMMIT;
+SELECT 1 AS blocked_again;           -- fails again after the scope ends
+SET agent_require_principal = off;
+SELECT 1 AS allowed_after_off;
